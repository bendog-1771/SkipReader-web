{
  "name": "skipreader-web",
  "version": "0.5.0",
  "private": true,
  "description": "SkipReader · 一跃 — free web reader with local backups and encrypted optional learning sync",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:web": "node scripts/build-web.cjs",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "start:web": "node scripts/serve-web.cjs",
    "test:sync": "node scripts/sync-model-regression.cjs && node scripts/sync-worker-regression.mjs",
    "test:dictionary": "node scripts/dictionary-worker-regression.mjs",
    "test:yujing": "node scripts/yujing-regression.cjs && node scripts/yuejing-stability-regression.cjs && node scripts/yuejing-refinement-regression.cjs",
    "test:music": "node scripts/music-envelope-regression.cjs",
    "test:continuity": "node scripts/yuejing-continuity-regression.cjs",
    "test:harmony": "node scripts/wind-layout-regression.cjs && node scripts/yuejing-harmony-regression.cjs",
    "test:experience": "node scripts/yuejing-experience-regression.cjs",
    "test:memories": "node scripts/book-memories-regression.cjs",
    "test:correspondence": "node scripts/yuejing-correspondence-regression.cjs",
    "test:storage": "node scripts/storage-upgrade-regression.cjs",
    "test:web": "node scripts/web-regression.cjs && node scripts/web-ux-regression.cjs && node scripts/web-feature-regression.cjs",
    "test:protection": "node scripts/protection-browser-regression.cjs"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "mammoth": "1.12.1",
    "marked": "14.1.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "playwright": "^1.56.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15"
  }
}
